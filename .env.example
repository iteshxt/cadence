# Cadence environment template.
#   API and worker: copy the "api" section to apps/api/.env
#   Web:            copy the "web" section to apps/web/.env.local (and to Vercel's project settings)
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # ENCRYPTION_KEY
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))" # STATE_SECRET

# ---------------------------------------------------------------- api
PORT=4000
LOG_LEVEL=info
WEB_URL=http://localhost:3000                  # prod: https://<project>.vercel.app
# Supabase session pooler (IPv4). For offline work: postgresql://cadence:cadence@localhost:5432/cadence
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<ref>.supabase.co
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ENCRYPTION_KEY=
STATE_SECRET=
WORKER_CONCURRENCY=5
MIN_SEND_GAP_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
GLOBAL_LIMITER_MAX=10
GLOBAL_LIMITER_DURATION_MS=1000
SEND_LEASE_MS=120000
START_GRACE_MS=300000
SEND_DRY_RUN=false                              # true: record sends without calling Gmail (load test only)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/integrations/slack/callback  # prod: https://<API_DOMAIN>/api/integrations/slack/callback
# Connect Gmail: the same Google OAuth client as Supabase sign-in, with the Gmail API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/integrations/gmail/callback  # prod: https://<API_DOMAIN>/api/integrations/gmail/callback
BULL_BOARD_USER=admin
BULL_BOARD_PASS=change-me-please

# ---------------------------------------------------------------- deploy (VM only, deploy/.env)
API_DOMAIN=cadence-api.duckdns.org
ACME_EMAIL=you@example.com

# ---------------------------------------------------------------- web
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=           # or the legacy anon key
NEXT_PUBLIC_API_URL=http://localhost:4000       # prod: https://<API_DOMAIN>
NEXT_PUBLIC_GITHUB_URL=https://github.com/iteshxt/cadence
